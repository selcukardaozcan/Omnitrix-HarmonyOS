<div class="container" onclick="transform" onswipe="handleSwipe">
    <stack class="stack-container">
        <image src="/common/images/omnitrix_base.png" class="base-bg"></image>

        <image src="{{currentImageSrc}}"
               class="alien-icon"
               style="transform: scale({{imageScale}}); opacity: {{currentOpacity}};">
        </image>

        <image src="{{nextImageSrc}}"
               class="alien-icon"
               style="transform: scale({{imageScale}}); opacity: {{nextOpacity}};">
        </image>

        <div if="{{isTransformed}}" class="flash-layer">
            <text class="transform-text">ACTIVE</text>
        </div>
        <div if="{{isRecharging}}" class="recharge-layer">
            <text class="recharge-text">ŞARJ...</text>
        </div>
    </stack>
</div>