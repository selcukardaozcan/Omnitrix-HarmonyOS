<div class="container" focusable="true" onrotation="handleRotation" onkeyevents="handleKey">
    <stack class="stack-container">
        <image src="/common/images/omnitrix_base.png" class="base-bg"></image>

        <image src="{{alienList[currentIndex]}}"
               class="alien-icon"
               style="transform: scale({{imageScale}});">
        </image>

        <div if="{{isTransformed}}" class="flash-layer">
            <text class="transform-text">ACTIVE</text>
        </div>
    </stack>
</div>