<div class="container" onswipe="handleSwipe">
    <stack class="stack-container">

        <image src="{{bgImageSrc}}" class="base-bg"></image>

        <div class="alien-box">
            <image show="{{!isBaseMode && !isTransformed && !isRecharging}}"
                   src="{{alienList[currentIndex]}}"
                   class="alien-icon">
            </image>
        </div>

        <image show="{{!isBaseMode && !isTransformed && !isRecharging}}"
               src="{{overlayImageSrc}}"
               class="overlay-frame">
        </image>

        <div if="{{isTransforming}}" class="green-flash"></div>

        <div if="{{isRecharging}}" class="recharge-layer"></div>

        <div class="click-area" onclick="transform"></div>

    </stack>
</div>